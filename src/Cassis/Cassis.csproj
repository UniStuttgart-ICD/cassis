<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
    <!-- Select the framework(s) you wish to target.
        Rhino 6: net45
        Rhino 7: net48
        Rhino 8 Windows: net48, net8.0, net8.0-windows, net8.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net8.0, net8.0-macos, net8.0-macos12.0, etc
    -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net8.0-windows;net8.0;net48</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('macos'))">net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net8.0</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.gha</TargetExt>
    <NoWarn>NU1701;NETSDK1086</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <Nullable>enable</Nullable>
    <AssemblyName>Cassis</AssemblyName>
    <RootNamespace>Cassis</RootNamespace>
    <Authors>ICD University of Stuttgart</Authors>
    <Copyright />
    <PackageProjectUrl>https://github.com/UniStuttgart-ICD/cassis</PackageProjectUrl>
    <RepositoryUrl>https://github.com/UniStuttgart-ICD/cassis</RepositoryUrl>
    <PackageTags>ModelContextProtocol;mcp;ai;llm;grasshopper;rhino</PackageTags>
    <SignAssembly>false</SignAssembly>
</PropertyGroup>

    <!-- Fix for .NET Framework 4.8 resource generation -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
        <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net8.0-windows'">
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Specifies information for Assembly and Yak -->
        <Version>1.3.4</Version>
        <Title>Cassis</Title>
        <Company></Company>
        <Description>MCP server plugin for Grasshopper (Rhino 8) that lets AI assistants read and edit Grasshopper definitions</Description>
    </PropertyGroup>

    <PropertyGroup>
        <YakExecutable Condition="'$(YakExecutable)' == '' and $([MSBuild]::IsOSPlatform('windows')) and Exists('$(ProgramFiles)\Rhino 8\System\yak.exe')">$(ProgramFiles)\Rhino 8\System\yak.exe</YakExecutable>
        <YakExecutable Condition="'$(YakExecutable)' == '' and $([MSBuild]::IsOSPlatform('macos')) and Exists('/Applications/Rhino 8.app/Contents/Resources/bin/yak')">/Applications/Rhino 8.app/Contents/Resources/bin/yak</YakExecutable>
        <BuildYakPackage Condition="'$(BuildYakPackage)' == '' and '$(Configuration)' == 'Release' and '$(YakExecutable)' != '' and Exists('$(YakExecutable)')">True</BuildYakPackage>
        <YakPlatform Condition="'$(YakPlatform)' == '' and $([MSBuild]::IsOSPlatform('windows'))">win</YakPlatform>
        <YakPlatform Condition="'$(YakPlatform)' == '' and $([MSBuild]::IsOSPlatform('macos'))">mac</YakPlatform>
        <YakPlatform Condition="'$(YakPlatform)' == ''">any</YakPlatform>
        <YakTargetFramework Condition="'$(YakPlatform)' == 'win'">net8.0-windows</YakTargetFramework>
        <YakTargetFramework Condition="'$(YakPlatform)' == 'mac'">net8.0</YakTargetFramework>
        <YakPackageOutputPath Condition="'$(YakPackageOutputPath)' == ''">$([MSBuild]::NormalizeDirectory('$(ArtifactsDir)', 'yak', '$(Configuration)'))</YakPackageOutputPath>
        <YakPackageStagePath>$([MSBuild]::NormalizeDirectory('$(YakPackageOutputPath)', 'stage'))</YakPackageStagePath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grasshopper" Condition="$(TargetFramework) == 'net48'" ExcludeAssets="runtime" />
        <PackageReference Include="Grasshopper" Condition="!$(TargetFramework.StartsWith('net4'))" ExcludeAssets="runtime" />
        <PackageReference Include="ModelContextProtocol.Core" />
        <PackageReference Include="RhinoCommon" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Bcl.Memory" Condition="$(TargetFramework) == 'net48'" />
        <PackageReference Include="System.Resources.Extensions" />
        <PackageReference Include="System.Text.Json" GeneratePathProperty="true" />
        <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="stylecop.json" />

    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../ModelContextProtocol.HttpListener/ModelContextProtocol.HttpListener.csproj" />
        <PackageReference Include="ModelContextProtocol" />
    </ItemGroup>

    <!-- For Windows only builds -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4'))">
        <UseWindowsForms>true</UseWindowsForms>
    </PropertyGroup>


    <!-- Reference WinForms for .NET 7.0 on macOS -->
    <ItemGroup Condition="!($(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4')))">
        <!-- Rhino 8.11 and later you can use this -->
        <!-- <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" /> -->

        <!-- Rhino 8.10 and earlier -->
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" ExcludeAssets="all" GeneratePathProperty="true" />
        <Reference Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\.NETFramework\v4.8\System.Windows.Forms.dll" Private="False" />
        <PackageReference Include="System.Drawing.Common" ExcludeAssets="runtime" />
    </ItemGroup>
    <ItemGroup>
      <Compile Update="Properties\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Update="Properties\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

  <!-- Collect dependency DLLs to deploy (everything except Rhino-provided and the plugin itself) -->
  <Target Name="CollectDeployDlls" AfterTargets="Build">
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net8.0-windows'">
      <PluginLocalRuntimeDll Include="$(PkgSystem_Text_Json)\lib\net8.0\System.Text.Json.dll"
                             Condition="Exists('$(PkgSystem_Text_Json)\lib\net8.0\System.Text.Json.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginLocalRuntimeDll)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="'@(PluginLocalRuntimeDll)' != ''" />
    <ItemGroup>
      <DeployDll Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(AssemblyName).dll" />
      <DeployDll Remove="$(TargetDir)RhinoCommon.dll" />
      <DeployDll Remove="$(TargetDir)Grasshopper.dll" />
      <DeployDll Remove="$(TargetDir)GH_IO.dll" />
      <DeployDll Remove="$(TargetDir)Eto.dll" />
      <DeployDll Remove="$(TargetDir)Rhino.UI.dll" />
    </ItemGroup>
    <RemoveDir Directories="$(TargetDir)runtimes" />
  </Target>

  <!-- Windows deploy path -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <WinGrasshopperLibrariesFolder>$(APPDATA)\Grasshopper\Libraries\Cassis</WinGrasshopperLibrariesFolder>
  </PropertyGroup>
  <Target Name="DeployToWindowsGrasshopperLibraries"
          AfterTargets="CollectDeployDlls"
          Condition="$(TargetFramework.Contains('-windows'))">
    <MakeDir Directories="$(WinGrasshopperLibrariesFolder)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName)$(TargetExt)"
          DestinationFolder="$(WinGrasshopperLibrariesFolder)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DeployDll)"
          DestinationFolder="$(WinGrasshopperLibrariesFolder)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Plugin GUID folder (Grasshopper loads .gha here) -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('macos'))">
    <GrasshopperPluginFolder>$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/Plug-ins/Grasshopper (b45a29b1-4343-4035-989e-044e8580d9cf)</GrasshopperPluginFolder>
    <GrasshopperLibrariesFolder>$(GrasshopperPluginFolder)/Libraries</GrasshopperLibrariesFolder>
  </PropertyGroup>
  <Target Name="DeployToGrasshopperPlugin"
          AfterTargets="CollectDeployDlls"
          Condition="$([MSBuild]::IsOSPlatform('macos')) And ('$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net8.0-macos')">
    <MakeDir Directories="$(GrasshopperPluginFolder)" Condition="!Exists('$(GrasshopperPluginFolder)')" />
    <Copy Condition="Exists('$(OutputPath)$(AssemblyName)$(TargetExt)')" SourceFiles="$(OutputPath)$(AssemblyName)$(TargetExt)" DestinationFolder="$(GrasshopperPluginFolder)" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(GrasshopperLibrariesFolder)" Condition="!Exists('$(GrasshopperLibrariesFolder)')" />
    <Copy Condition="Exists('$(OutputPath)$(AssemblyName)$(TargetExt)')" SourceFiles="$(OutputPath)$(AssemblyName)$(TargetExt)" DestinationFolder="$(GrasshopperLibrariesFolder)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DeployDll)" DestinationFolder="$(GrasshopperPluginFolder)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DeployDll)" DestinationFolder="$(GrasshopperLibrariesFolder)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BuildYakPackage"
          AfterTargets="DispatchToInnerBuilds"
          Condition="'$(BuildYakPackage)' == 'True'">
    <Error Text="Yak executable not found. Set YakExecutable to a valid Yak CLI path."
           Condition="'$(YakExecutable)' == '' Or !Exists('$(YakExecutable)')" />
    <Error Text="YakPlatform must be 'win' or 'mac'."
           Condition="'$(YakTargetFramework)' == ''" />
    <Error Text="Missing $(YakTargetFramework) plugin output."
           Condition="!Exists('$(OutputPath)$(YakTargetFramework)\$(AssemblyName)$(TargetExt)')" />

    <ItemGroup>
      <YakFrameworkFiles Include="$(OutputPath)$(YakTargetFramework)\$(AssemblyName)$(TargetExt);$(OutputPath)$(YakTargetFramework)\*.dll" />
      <YakPackagesToDelete Include="$(YakPackageOutputPath)cassis-$(Version)-*-$(YakPlatform).yak" />
    </ItemGroup>

    <RemoveDir Directories="$(YakPackageStagePath)" />
    <MakeDir Directories="$(YakPackageOutputPath);$(YakPackageStagePath);$(YakPackageStagePath)logo;$(YakPackageStagePath)docs;$(YakPackageStagePath)skills\cassis-setup\references;$(YakPackageStagePath)$(YakTargetFramework)" />
    <Delete Files="@(YakPackagesToDelete)" />

    <Copy SourceFiles="$(RepoRoot)manifest.yml;$(RepoRoot)LICENSE;$(RepoRoot)THIRD-PARTY-NOTICES.md"
          DestinationFolder="$(YakPackageStagePath)" />
    <Copy SourceFiles="$(RepoRoot)logo\cassis_logo.png"
          DestinationFolder="$(YakPackageStagePath)logo" />
    <Copy SourceFiles="$(RepoRoot)docs\agent-setup.md"
          DestinationFolder="$(YakPackageStagePath)docs" />
    <Copy SourceFiles="$(RepoRoot)skills\cassis-setup\SKILL.md"
          DestinationFolder="$(YakPackageStagePath)skills\cassis-setup" />
    <Copy SourceFiles="$(RepoRoot)skills\cassis-setup\references\mcp-config-guide.md"
          DestinationFolder="$(YakPackageStagePath)skills\cassis-setup\references" />
    <Copy SourceFiles="@(YakFrameworkFiles)" DestinationFolder="$(YakPackageStagePath)$(YakTargetFramework)" />

    <Exec Command="&quot;$(YakExecutable)&quot; build --platform $(YakPlatform) --version $(Version)"
          WorkingDirectory="$(YakPackageStagePath)" />

    <ItemGroup>
      <BuiltYakPackage Include="$(YakPackageStagePath)*.yak" />
    </ItemGroup>
    <Error Text="Yak did not produce a package." Condition="'@(BuiltYakPackage)' == ''" />
    <Copy SourceFiles="@(BuiltYakPackage)" DestinationFolder="$(YakPackageOutputPath)" />
    <RemoveDir Directories="$(YakPackageStagePath)" />
    <Message Text="Yak package: @(BuiltYakPackage->'$(YakPackageOutputPath)%(Filename)%(Extension)')" Importance="high" />
  </Target>

</Project>
